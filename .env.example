# ==============================================================================
# TeerResult24 - Production Cloudflare Workers & PostgreSQL Environment Template
# ==============================================================================
# Set these variables in Cloudflare Dashboard:
# Workers & Pages -> teerresult24 -> Settings -> Variables and Secrets

# 1. Production PostgreSQL Database (Required)
# Use a pooled connection string (Neon, Supabase, Cloudflare Hyperdrive, Aiven, Railway, AWS RDS)
DATABASE_URL="postgresql://username:password@ep-host.pooler.region.neon.tech/dbname?sslmode=require"

# 2. Authentication Secrets (Required: 64-char crypto random hex)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_64_character_crypto_random_hex_secret"

# 3. Scheduled Cron Sync Token (Required: Bearer token for /api/cron/sync-results)
CRON_SECRET="replace_with_64_character_crypto_random_hex_secret"

# 4. Editorial Admin Initial Credentials (Used during prisma:seed)
ADMIN_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="ReplaceWithAComplex16+CharacterPassword!"

# 5. Automation Safeguard (Strictly false until official authority provenance validated)
AUTO_PUBLISH_ENABLED="false"
