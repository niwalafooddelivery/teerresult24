{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teerresult24",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0065e4cbbf8b417da645221ab4e53bd6",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/neondb"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
